<Window x:Class="UsbBackup.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="USB Backup" Icon="app.ico" Height="720" Width="980" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7"
        FontFamily="Segoe UI" FontSize="13" Activated="Window_Activated" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1F5FBF"/>
            <Setter Property="BorderBrush" Value="#1F5FBF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#174A96"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Background" Value="#A9B4C4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE1E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5B6573"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Destination -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Back up to" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <ComboBox x:Name="DriveBox" Grid.Column="1" Padding="8,5" SelectionChanged="DriveBox_SelectionChanged"/>
                <Button Grid.Column="2" Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Border x:Name="LockBadge" CornerRadius="10" Padding="10,2" Background="#E5E7EB" Margin="0,0,10,0">
                        <TextBlock x:Name="LockText" Text="No drive" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                    <TextBlock x:Name="DriveNote" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="Tabs" Background="Transparent" BorderThickness="0" Padding="0,12,0,0">
            <!-- BACK UP -->
            <TabItem Header="Back up" Padding="16,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H}" Text="My folders"/>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="Each run makes a dated version you can browse. Files that have not changed take no extra room."/>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="BackupButton" Style="{StaticResource Primary}" Content="Back up folders now" Click="BackupFolders_Click"/>
                                <TextBlock x:Name="LastBackupText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="AddFolderButton" Content="Add folder…" Click="AddFolder_Click"/>
                                <Button x:Name="RemoveFolderButton" Content="Remove" Click="RemoveFolder_Click"/>
                            </StackPanel>
                            <ListBox x:Name="FolderList" SelectionMode="Extended" BorderBrush="#DDE1E7"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H}" Text="System image"/>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <TextBlock x:Name="LastImageText" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                                <Button x:Name="ImageButton" Style="{StaticResource Primary}" Content="Create system image" HorizontalAlignment="Left" Click="SystemImage_Click"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Style="{StaticResource Hint}">
                                    A complete copy of the Windows drive, for rebuilding this PC after a disk failure.
                                    <LineBreak/><LineBreak/>
                                    Uses Windows' own imaging tool: Windows asks for administrator approval and saves it as WindowsImageBackup on the drive.
                                    <LineBreak/><LineBreak/>
                                    To restore: start from Windows recovery or install media → Troubleshoot → Advanced options → System Image Recovery.
                                </TextBlock>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- RESTORE -->
            <TabItem Header="Restore" Padding="16,6">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="240"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource H}" Text="Versions"/>
                        <TextBlock Grid.Column="2" Style="{StaticResource H}" Text="What was in it"/>
                        <ListBox x:Name="SnapshotList" Grid.Row="1" BorderBrush="#DDE1E7" SelectionChanged="SnapshotList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,4"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TreeView x:Name="SnapshotTree" Grid.Row="1" Grid.Column="2" BorderBrush="#DDE1E7" SelectedItemChanged="SnapshotTree_SelectedItemChanged"/>
                        <TextBlock x:Name="RestoreHint" Grid.Row="2" Style="{StaticResource Hint}" Margin="0,12,0,0" VerticalAlignment="Center"
                                   Text="Pick a version, then a folder or file."/>
                        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="RestoreToButton" Style="{StaticResource Primary}" Content="Restore to a folder…" Click="RestoreTo_Click" IsEnabled="False"/>
                            <Button x:Name="RestoreOriginalButton" Content="Put back where it was" Click="RestoreOriginal_Click" IsEnabled="False"/>
                            <Button x:Name="OpenExplorerButton" Content="Open in Explorer" Click="OpenExplorer_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- SETTINGS -->
            <TabItem Header="Settings" Padding="16,6">
                <Border Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource H}" Text="How many versions to keep"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="After each backup, versions that none of these rules want are removed. The newest version is always kept."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Most recent versions" VerticalAlignment="Center" Margin="0,4,12,4"/>
                                <TextBox x:Name="KeepLastBox" Grid.Column="1" Margin="0,4" Padding="4,3"/>
                                <TextBlock Grid.Row="1" Text="One per day, for this many days" VerticalAlignment="Center" Margin="0,4,12,4"/>
                                <TextBox x:Name="KeepDailyBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="4,3"/>
                                <TextBlock Grid.Row="2" Text="One per week, for this many weeks" VerticalAlignment="Center" Margin="0,4,12,4"/>
                                <TextBox x:Name="KeepWeeklyBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Padding="4,3"/>
                                <TextBlock Grid.Row="3" Text="One per month, for this many months" VerticalAlignment="Center" Margin="0,4,12,4"/>
                                <TextBox x:Name="KeepMonthlyBox" Grid.Row="3" Grid.Column="1" Margin="0,4" Padding="4,3"/>
                            </Grid>

                            <TextBlock Style="{StaticResource H}" Text="Automatic backup" Margin="0,18,0,6"/>
                            <CheckBox x:Name="AutoBox" Content="Back up my folders automatically when the backup drive is plugged in or unlocked" Margin="0,3"/>
                            <StackPanel Orientation="Horizontal" Margin="20,3,0,3">
                                <TextBlock Text="But not if the last backup is less than" VerticalAlignment="Center"/>
                                <TextBox x:Name="AutoHoursBox" Width="50" Margin="8,0" Padding="4,3"/>
                                <TextBlock Text="hours old" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <CheckBox x:Name="DailyBox" Content="Also back up my folders every day at" VerticalAlignment="Center"/>
                                <TextBox x:Name="DailyTimeBox" Width="60" Margin="8,0" Padding="4,3"/>
                                <TextBlock Text="(24-hour, e.g. 13:00)" VerticalAlignment="Center" Foreground="#6B7280"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,3"
                                       Text="If the drive is away or locked at that time, the backup runs when it is next connected."/>
                            <CheckBox x:Name="StartupBox" Content="Start USB Backup when I sign in to Windows (in the notification area)" Margin="0,3"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="The app has to be running for either of these. While one is on, closing the window keeps it running in the notification area; right-click its icon to exit. Files another program has open are skipped, so pick a time when the PC is on but idle. A system image is never started automatically."/>

                            <TextBlock Style="{StaticResource H}" Text="Leave out" Margin="0,18,0,4"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="One per line. A name (wildcards allowed, e.g. *.tmp) is left out wherever it appears; a full path leaves out just that folder or file."/>
                            <TextBox x:Name="ExcludesBox" AcceptsReturn="True" Height="110" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="4"/>

                            <TextBlock Style="{StaticResource H}" Text="Safety" Margin="0,18,0,6"/>
                            <CheckBox x:Name="RequireBitLockerBox" Content="Only back up to a drive protected by BitLocker" Margin="0,3"/>
                            <CheckBox x:Name="SkipCloudBox" Content="Skip cloud-only files (OneDrive / Google Drive files not downloaded to this PC)" Margin="0,3"/>
                            <CheckBox x:Name="VerifyBox" Content="Check every copied file against the original (slower)" Margin="0,3"/>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Style="{StaticResource Primary}" Content="Save settings" Click="SaveSettings_Click"/>
                                <TextBlock x:Name="SettingsSaved" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Activity -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready." TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Button x:Name="CancelButton" Grid.Column="1" Content="Stop" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click"/>
                <ProgressBar x:Name="Progress" Grid.Row="1" Grid.ColumnSpan="2" Height="8" Margin="0,8" Minimum="0" Maximum="100"/>
                <TextBox x:Name="LogBox" Grid.Row="2" Grid.ColumnSpan="2" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderBrush="#DDE1E7" Background="#FAFBFC"/>
            </Grid>
        </Border>
    </Grid>
</Window>
